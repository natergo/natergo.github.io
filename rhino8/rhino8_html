<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Instructional Site</title>
  <style>
    /* ---------- Theme Variables ---------- */
    :root{
      --bg:#fafafa; --card:#fff; --text:#111217; --muted:#5a5f66;
      --accent:#0560a8; --callout-bg:#fffbe6; --header-bg:#0a3a66;
      --footer-bg:#efefef; --kbd-bg:#eee;
    }
    :root[data-theme="dark"]{
      --bg:#0b0f13; --card:#0f1418; --text:#e6eef6; --muted:#b6c2cc;
      --accent:#7ec7ff; --callout-bg:#1a2a36; --header-bg:#061822;
      --footer-bg:#071018; --kbd-bg:#1b2126;
    }
    @media (prefers-color-scheme: dark){
      :root{ --bg:#0b0f13; --card:#0f1418; --text:#e6eef6; --muted:#b6c2cc;
             --accent:#7ec7ff; --callout-bg:#1a2a36; --header-bg:#061822;
             --footer-bg:#071018; --kbd-bg:#1b2126; }
    }

    /* ---------- Layout ---------- */
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial;
         background:var(--bg);color:var(--text);line-height:1.5;}
    .container{max-width:920px;margin:1.25rem auto;padding:1rem}

    .site-header{background:var(--header-bg);color:var(--card);padding:1rem 0}
    .site-header .container{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
    .site-header h1{margin:0;font-size:1.2rem}
    .site-header .muted{margin:0;opacity:.95;font-size:.9rem;color:var(--card)}

    .theme-toggle{background:transparent;border:1px solid rgba(255,255,255,0.2);
      color:var(--card);padding:.4rem .6rem;border-radius:8px;cursor:pointer;font-size:.9rem}
    .theme-toggle:focus{outline:3px solid rgba(126,199,255,0.3);outline-offset:2px}

    main{margin-top:1rem}
    .steps{background:var(--card);padding:1rem;border-radius:10px;list-style:decimal;margin:0 0 1rem 1.25rem}
    .steps li{margin:0 0 1rem}
    .callout{background:var(--callout-bg);border-left:4px solid rgba(0,0,0,0.1);padding:.6rem;margin-top:.5rem;border-radius:6px}
    a{color:var(--accent)}
    .site-footer{background:var(--footer-bg);padding:.9rem;text-align:center;margin-top:1rem;color:var(--muted)}
    kbd{background:var(--kbd-bg);border-radius:6px;padding:.15rem .35rem;font-size:.9em;color:var(--text)}

    @media(max-width:640px){.site-header .container{flex-direction:column;align-items:flex-start}}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <div>
        <h1>Install &amp; Use Example App</h1>
        <p class="muted">Internal instructions — follow IT policy</p>
      </div>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle site theme">System</button>
    </div>
  </header>

  <main class="container">
    <h2>Step-by-Step Instructions</h2>
    <ol class="steps">
      <li>Press <kbd>⊞ Win</kbd>, search for <strong>Example App</strong>, right-click → <em>Uninstall</em>.</li>
      <li>Open <strong>Settings → Apps</strong>, confirm removal, restart if prompted.</li>
      <li>Download the latest installer from the official vendor site and install.</li>
      <li>After installation, configure according to IT guidance. If offline activation is required, contact IT for keys.</li>
      <li>Verify the app launches correctly and report issues to support.</li>
    </ol>

    <div class="callout">
      <strong>Note:</strong> Do not share license keys in this guide or repository. Obtain them securely from IT.
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <small>Company internal documentation — do not share publicly.</small>
    </div>
  </footer>

  <script>
    (function(){
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const KEY = 'site-theme-preference';

      function applyTheme(pref){
        if(pref==='system'||!pref){
          root.removeAttribute('data-theme');
          localStorage.removeItem(KEY);
        } else {
          root.setAttribute('data-theme', pref);
          localStorage.setItem(KEY, pref);
        }
        btn.textContent = pref ? pref[0].toUpperCase()+pref.slice(1) : 'System';
      }

      const saved = localStorage.getItem(KEY);
      applyTheme(saved||'system');

      btn.addEventListener('click', ()=>{
        const current = localStorage.getItem(KEY)||'system';
        const next = current==='system' ? 'dark' : current==='dark' ? 'light' : 'system';
        applyTheme(next);
      });
    })();
  </script>
</body>
</html>
